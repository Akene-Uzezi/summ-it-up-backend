# Server Configuration
PORT=3001

# Redis Configuration
redisUrl=redis://localhost:6379

# Cerebras AI API Key (required)
# Get your API key from https://inference.cerebras.ai
apiKey=your_cerebras_api_key_here

# Chrome/Chromium Executable Path (optional)
# Path to Chrome or Chromium browser for puppeteer
# Default: /usr/bin/chromium
# Example for macOS: /Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome
# Example for Ubuntu: /usr/bin/google-chrome
chromePath=/usr/bin/chromium
